# ──────────────────────────────────────────────────────────
# Vercel → Heroku connection
# ──────────────────────────────────────────────────────────
#
# LOCAL DEV: Leave VITE_API_BASE_URL empty.
#   Vite's dev-server proxy will forward /api/* → localhost:8000
#
# PRODUCTION (Vercel): Add this as a Vercel Environment Variable:
#   VITE_API_BASE_URL = https://your-app-name.herokuapp.com
#   (no trailing slash)
#
VITE_API_BASE_URL=
